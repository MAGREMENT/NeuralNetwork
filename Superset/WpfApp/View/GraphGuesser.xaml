<Page x:Class="WpfApp.View.GraphGuesser"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:WpfApp.View"
      mc:Ignorable="d"
      Title="GraphGuesser" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        
        <local:GuessingGraph x:Name="Graph" Grid.Column="0"/>
        <StackPanel Grid.Column="1" Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
                <Button Click="Generate">Generate</Button>
                <Button Click="Remove">Remove</Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock>Cost :</TextBlock>
                <TextBlock x:Name="CostBlock"></TextBlock>
            </StackPanel>
            <Button Click="Learn">Learn</Button>
        </StackPanel>
    </Grid>
</Page>
